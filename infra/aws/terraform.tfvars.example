aws_region   = "us-east-1"
name         = "virtusp"
image_tag    = "latest"

# ACM certificate in the same region. Leave unset to serve trusted HTTPS
# from CloudFront. Microphone access requires that HTTPS address.
# certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"

# Deployed task calls use Grok 4.7 at high reasoning, through the task role.
# bedrock_model_id = "us.xai.grok-4.7"

db_instance_class = "db.t4g.micro"
# On for the database and the load balancer. Set false and apply before destroy.
deletion_protection = true

# Both policies are created. The service scales from 4 to 8 containers
# across the two Availability Zones.
# autoscaling_min_capacity  = 4
# autoscaling_max_capacity  = 8
# autoscaling_cpu_target    = 70
# autoscaling_memory_target = 75
