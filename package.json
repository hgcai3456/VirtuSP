{
  "name": "virtusp",
  "version": "1.0.0",
  "private": true,
  "description": "VirtuSP — virtual standardized patient simulator for healthcare education",
  "scripts": {
    "start": "node server.js",
    "photos:import": "node scripts/import-patient-photos.js",
    "cert:local": "node scripts/ensure-dev-cert.js",
    "dev:https": "node scripts/dev-https.js",
    "test:pact": "node --test --test-concurrency=1 --test-timeout=120000 tests/pact/*.test.js",
    "demo:sync": "node scripts/sync-demo.js",
    "demo:bias": "node scripts/prepare-bias-demo.js",
    "test": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter=./agents/suite-reporter.js --test-reporter-destination=stdout --test-reporter-destination=stdout --test-timeout=120000 tests/*.test.js",
    "preflight": "node scripts/preflight.js",
    "corpus:fetch": "node scripts/fetch-corpus.js",
    "evaluate": "node scripts/evaluate.js",
    "evaluate:local": "node scripts/evaluate.js --local",
    "setup:aws": "node scripts/storage.js configure",
    "backup": "node scripts/storage.js backup",
    "restore": "node scripts/storage.js restore",
    "profiles:archive": "node agents/profile-archive.js",
    "test:e2e": "cucumber-js --config tests/e2e/cucumber.js",
    "test:e2e:session": "cucumber-js --config tests/e2e/cucumber.js --profile session",
    "test:integration": "node --test --test-concurrency=1 --test-timeout=60000 tests/integration/live-stack.js",
    "test:regression": "node agents/regression.js",
    "test:appointment": "node agents/appointment-regression.js",
    "avatar:smoke": "node scripts/avatar-smoke.js",
    "test:live": "node agents/live-regression.js",
    "chat:tracker": "node agents/chat-tracker.js",
    "perf": "powershell -NoProfile -ExecutionPolicy Bypass -File perf/run-jmeter.ps1",
    "perf:ci": "node perf/ci.js",
    "prepare": "node scripts/install-git-hooks.js",
    "orchestrate": "node agents/orchestrator.js --tests",
    "ingest": "node agents/ingest.js",
    "ingest:seed": "node agents/ingest.js --seed",
    "ingest:nih": "node agents/ingest.js --nih --shards 2 --shard 0 --chunk 20 --delay 800 --per-illness 200",
    "ingest:nih:2": "node agents/ingest.js --nih --shards 2 --shard 1 --chunk 20 --delay 800 --per-illness 200",
    "ingest:nih:resume": "node agents/ingest.js --nih --resume --shards 2 --shard 0 --chunk 20 --delay 800 --per-illness 200",
    "ingest:nih:2:resume": "node agents/ingest.js --nih --resume --shards 2 --shard 1 --chunk 20 --delay 800 --per-illness 200",
    "ingest:nih:all": "node agents/ingest.js --nih --all --resume --shards 2 --shard 0 --chunk 20 --delay 800",
    "ingest:status": "node agents/ingest.js --status",
    "ingest:conversations": "node agents/conversations.js --chunk 10 --delay 800",
    "ingest:conversations:resume": "node agents/conversations.js --resume --chunk 10 --delay 800",
    "ingest:conversations:status": "node agents/conversations.js --status",
    "ingest:orchestrate": "node agents/orchestrator.js",
    "pathology:load": "node agents/pathology.js",
    "obs:local": "node scripts/observability-local.js",
    "obs:test": "node --test --test-timeout=120000 tests/observability.test.js",
    "obs:smoke": "node scripts/observability-scenario.js",
    "obs:validate": "node scripts/observability-validate.js && node scripts/secret-scan.js",
    "obs:plan": "node scripts/observability-plan.js",
    "obs:verify-aws": "node scripts/observability-verify-aws.js",
    "obs:teardown-plan": "node scripts/observability-teardown-plan.js"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-bedrock-runtime": "^3.0.0",
    "@aws-sdk/client-cloudwatch": "3.1149.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1149.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.57.2",
    "@opentelemetry/resources": "1.30.1",
    "@opentelemetry/sdk-trace-base": "1.30.1",
    "@opentelemetry/sdk-trace-node": "1.30.1",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@pact-foundation/pact": "^17.1.4",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "selenium-webdriver": "^4.35.0"
  }
}
