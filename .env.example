# Copy to .env. Never put secrets in public/ or commit .env.
PORT=3000
HOST=127.0.0.1
# Comma-separated browser origins. The secure demo is https://localhost:3002.
ALLOWED_ORIGINS=https://localhost:3002
# Trust X-Forwarded-* only when both are set and the edge header matches.
VIRTUSP_TRUST_PROXY=false
VIRTUSP_EDGE_SECRET=
VIRTUSP_REQUIRE_HTTPS=false
VIRTUSP_HSTS=false
VIRTUSP_SESSION_TTL_MS=43200000
VIRTUSP_RATE_LIMIT=240
VIRTUSP_DEMO_MODE=false
VIRTUSP_DATA_DIR=data
AWS_REGION=us-west-2
# Paste all THREE values from Workshop Studio > Get AWS CLI credentials.
# Alternatively, set AWS_PROFILE to a named CLI profile; do not use both methods.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Enable after npm run preflight succeeds in the intended Workshop account.
# Patient and encounter requests then go to Bedrock through these AWS credentials.
# There is no separate model API key.
AI_ENABLED=false
# Optional: use the Claude API instead of Bedrock. Leave AI_PROVIDER empty for Bedrock.
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_TIMEOUT_MS=60000
AWS_IMAGES_ENABLED=false
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_TIMEOUT_MS=25000
# Strict JSON schemas are enabled for supported Claude 4.5/4.6 models.
# The first schema compilation can take minutes; subsequent calls use AWS's cache.
BEDROCK_STRUCTURED_OUTPUTS=true
BEDROCK_SCHEMA_TIMEOUT_MS=180000
S3_BUCKET=
S3_PREFIX=virtusp
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Set to false to remove the bundled demo patients: the library then holds only
# patients faculty import, generate or write. Default (unset) keeps them.
BUNDLED_PATIENTS=
# Talking-patient avatar. Leave disabled until LIVEAVATAR_API_KEY and
# LIVEAVATAR_DEFAULT_AVATAR_ID are set locally. LITE mode renders audio the
# VirtuSP case engine already approved. It does not run a second dialogue model.
# AVATAR_PROVIDER=mock is for automated tests only and is not a live session.
AVATAR_ENABLED=false
AVATAR_PROVIDER=liveavatar
LIVEAVATAR_API_KEY=
LIVEAVATAR_DEFAULT_AVATAR_ID=
LIVEAVATAR_MODE=LITE
AVATAR_MAX_SESSION_SECONDS=600
AVATAR_IDLE_TIMEOUT_SECONDS=90
# Shared hosting stays off until encounters have real authentication.
AVATAR_LOCAL_ONLY=true
# Observability. Leave OBS_ENABLED true. Local mode does not need AWS credentials.
# EMF lines are written to stdout only when OBS_EMF=true (the ECS task sets this).
OBS_ENABLED=true
OBS_ENVIRONMENT=local
OBS_SYNTHETIC=true
OBS_EMF=false
OBS_LOG_STDOUT=false
OBS_LOG_LEVEL=info
OBS_TRACE_SAMPLE_RATIO=1
OBS_HEARTBEAT=false
OBS_FAULT_INJECTION=0
OBS_AWS_READ=false
OBS_ALARM_PREFIX=virtusp-
OBS_LOG_GROUP=
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
