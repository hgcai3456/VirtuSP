# Copy to .env. Never put secrets in public/ or commit .env.
PORT=3000
HOST=127.0.0.1
VIRTUSP_DATA_DIR=data
AWS_REGION=us-west-2
# Paste all THREE values from Workshop Studio > Get AWS CLI credentials.
# Alternatively, set AWS_PROFILE to a named CLI profile; do not use both methods.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Enable after npm run preflight succeeds in the intended Workshop account.
# Patient and encounter requests then go to Bedrock through these AWS credentials.
# There is no separate model API key.
AI_ENABLED=false
# Optional: use the Claude API instead of Bedrock. Leave AI_PROVIDER empty for Bedrock.
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_TIMEOUT_MS=60000
AWS_IMAGES_ENABLED=false
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_TIMEOUT_MS=25000
# Strict JSON schemas are enabled for supported Claude 4.5/4.6 models.
# The first schema compilation can take minutes; subsequent calls use AWS's cache.
BEDROCK_STRUCTURED_OUTPUTS=true
BEDROCK_SCHEMA_TIMEOUT_MS=180000
S3_BUCKET=
S3_PREFIX=virtusp
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Set to false to remove the bundled demo patients: the library then holds only
# patients faculty import, generate or write. Default (unset) keeps them.
BUNDLED_PATIENTS=

# Patient conversation style. natural = one in-character model call per turn
# (any provider). strict = staged pipeline with approved wording only.
# Unset: natural with the Claude API, strict with Bedrock.
DIALOGUE_MODE=
